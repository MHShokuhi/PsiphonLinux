[Unit]
Description=Psiphon Tunnel Service
Documentation=https://github.com/MHShokuhi/PsiphonLinux
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=psiphon
Group=psiphon
StateDirectory=psiphon
StateDirectoryMode=0750
WorkingDirectory=/var/lib/psiphon
ExecStart=/etc/psiphon/psiphon-tunnel-core-x86_64 -config /etc/psiphon/psiphon.config -dataRootDirectory /var/lib/psiphon -formatNotices
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120s
TimeoutStopSec=30s
KillSignal=SIGTERM
LimitNOFILE=65536
UMask=0077


NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=true
RemoveIPC=true
SystemCallArchitectures=native

# Only needed if you configure a proxy port below 1024; remove both lines otherwise.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE


StandardOutput=journal
StandardError=journal
SyslogIdentifier=psiphon

[Install]
WantedBy=multi-user.target
